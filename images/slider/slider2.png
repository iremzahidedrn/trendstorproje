<!-- Slide 2 - Men's Fashion -->
<svg width="1200" height="500" viewBox="0 0 1200 500" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="slide2Bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2C3E50;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#34495E;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="textGlow" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FFFFFF;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ECF0F1;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="1200" height="500" fill="url(#slide2Bg)"/>
  
  <!-- Geometric pattern -->
  <pattern id="geoPattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
    <rect width="100" height="100" fill="none"/>
    <path d="M 0 50 L 50 0 L 100 50 L 50 100 Z" fill="rgba(255,255,255,0.03)"/>
  </pattern>
  <rect width="1200" height="500" fill="url(#geoPattern)"/>
  
  <!-- Main content area -->
  <rect x="100" y="50" width="1000" height="400" rx="15" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.1)" stroke-width="2"/>
  
  <!-- Main title -->
  <text x="600" y="150" font-family="Arial, sans-serif" font-size="60" font-weight="900" fill="url(#textGlow)" text-anchor="middle">ERKEK GİYİM</text>
  
  <!-- Subtitle -->
  <text x="600" y="200" font-family="Arial, sans-serif" font-size="28" fill="rgba(255,255,255,0.8)" text-anchor="middle">Premium Koleksiyon</text>
  
  <!-- Brand names -->
  <text x="300" y="280" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="rgba(255,255,255,0.9)" text-anchor="middle">BOSS</text>
  <text x="500" y="280" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="rgba(255,255,255,0.9)" text-anchor="middle">CALVIN KLEIN</text>
  <text x="700" y="280" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="rgba(255,255,255,0.9)" text-anchor="middle">ARMANI</text>
  <text x="900" y="280" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="rgba(255,255,255,0.9)" text-anchor="middle">GUESS</text>
  
  <!-- Decorative lines -->
  <line x1="200" y1="250" x2="400" y2="250" stroke="rgba(255,255,255,0.4)" stroke-width="3"/>
  <line x1="450" y1="250" x2="650" y2="250" stroke="rgba(255,255,255,0.4)" stroke-width="3"/>
  <line x1="700" y1="250" x2="900" y2="250" stroke="rgba(255,255,255,0.4)" stroke-width="3"/>
  
  <!-- Call to action -->
  <rect x="450" y="330" width="300" height="60" rx="30" fill="rgba(52,152,219,0.8)" stroke="rgba(41,128,185,1)" stroke-width="2"/>
  <text x="600" y="370" font-family="Arial, sans-serif" font-size="20" font-weight="bold" fill="#FFF" text-anchor="middle">KOLEKSİYONU KEŞFET</text>
  
  <!-- Corner decorations -->
  <circle cx="150" cy="100" r="8" fill="rgba(52,152,219,0.6)"/>
  <circle cx="1050" cy="100" r="8" fill="rgba(52,152,219,0.6)"/>
  <circle cx="150" cy="400" r="8" fill="rgba(52,152,219,0.6)"/>
  <circle cx="1050" cy="400" r="8" fill="rgba(52,152,219,0.6)"/>
</svg>